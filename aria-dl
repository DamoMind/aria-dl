#!/usr/bin/env python3
"""aria-dl: reusable downloader for torrent files, magnet links, http(s) URLs (aria2c) and video sites (yt-dlp).

Usage:
  aria-dl add SOURCE [SOURCE ...] [--file FILE] [--dir DIR] [--when now|night] [--name LABEL] [--limit RATE] [--retries N] [--cookies-from-browser BROWSER[:PROFILE]] [--media] [--audio] [--max-height N] [--json]
  aria-dl list [--json]
  aria-dl status ID [ID ...] [--json]
  aria-dl pause ID [ID ...] | all [--json]
  aria-dl resume ID [ID ...] | all | failed | paused [--json]
  aria-dl remove ID [ID ...] | failed | complete [--json]
  aria-dl log ID [-n N]
  aria-dl tick                                   (LaunchAgent safety net, on job exit, and at the next retry)

Multiple tasks:
  - Pass several SOURCE arguments at once
  - Or pass --file urls.txt (-f - for stdin), one source per line (# comments and blank lines ignored)
  - Or pipe lines into stdin: pbpaste | aria-dl add --when night

--when now   : start immediately, any network (default)
--when night : only 22:00-08:00 and only when the default route is Wi-Fi; pauses outside that
Concurrency  : up to 2 media (yt-dlp) + 3 aria2c jobs run at once; extras queue and auto-start as slots free.
Retries      : yt-dlp is started with --retries 5 --fragment-retries 5 --retry-sleep exp=1:30.
               A non-zero exit (except aria2c code 7, which stays "waiting") is retried
               --retries N times (default 5, env ARIA_DL_MAX_RETRIES, 0 disables) in state
               "retrying", with backoff 2m, 5m, 15m, 30m, then 60m. One sleeper runs tick
               at the next retry time. resume of a failed or retrying job resets the counter.
Bulk         : resume failed re-queues failed and retrying jobs. resume paused re-queues
               paused jobs. resume all is paused, failed, waiting, and retrying.
               remove failed / remove complete forget those job records only.
               Selectors can be mixed with IDs and are deduplicated. Text mode prints
               "resumed N jobs (...)" ; nothing matched prints "no jobs matched".
Cookies      : --cookies-from-browser BROWSER[:PROFILE], else ARIA_DL_COOKIES_FROM_BROWSER,
               else cookies_from_browser in ~/.local/share/aria-dl/config.json, else the
               Netscape file cookies/youtube.txt. Never both --cookies and --cookies-from-browser.
Jobs live in ~/.local/share/aria-dl/jobs/<ID>/ ; downloads resume automatically (--continue).
"""
import argparse, fcntl, hashlib, json, os, re, signal, subprocess, sys, time, shutil, datetime

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".local/share/aria-dl")
JOBS = os.path.join(BASE, "jobs")
LOCK = os.path.join(BASE, ".tick.lock")
PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
TRACKERS_URL = "https://cf.trackerslist.com/best_aria2.txt"
MEDIA_HOSTS = re.compile(r"^https?://([\w-]+\.)*(youtube\.com|youtu\.be|bilibili\.com|b23\.tv|x\.com|twitter\.com|vimeo\.com|nicovideo\.jp|tiktok\.com|instagram\.com|soundcloud\.com)(/|$)", re.I)
YTP = re.compile(r"\[download\]\s+([\d.]+)% of\s+~?\s*([\d.]+\w*B)(?: at\s+([\d.]+\w*B/s|Unknown B/s))?(?: ETA (\S+))?")
COOKIES = os.path.join(BASE, "cookies", "youtube.txt")
PROG = re.compile(r"\[#\w+ ([\d.]+\w*B)/([\d.]+\w*B)\((\d+)%\) CN:(\d+)(?: SD:(\d+))? DL:([\d.]+\w*B)(?: ETA:(\S+?))?\]")
MAX_MEDIA = int(os.environ.get("ARIA_DL_MAX_MEDIA", "2"))
MAX_ARIA = int(os.environ.get("ARIA_DL_MAX_ARIA", "3"))
try: DEFAULT_RETRIES = max(0, int(os.environ.get("ARIA_DL_MAX_RETRIES", "5")))
except (TypeError, ValueError): DEFAULT_RETRIES = 5
RETRY_BACKOFFS = (120, 300, 900, 1800, 3600)  # 2m, 5m, 15m, 30m, 60m
WAKE = os.path.join(BASE, ".retry-wake.json")
# Sleep, drop this wake record only if its token is still current, then exec tick.
# Deleting first keeps tick from observing its own pid; a replaced sleeper keeps its record.
WAKE_SCRIPT = (
    'sleep "$1"; wake="$2"; token="$3"; me="$4"; cur=""; '
    '[ -f "$wake" ] && cur=$(cat "$wake"); '
    'case "$cur" in *"$token"*) rm -f "$wake";; esac; '
    'exec "$me" tick'
)

def now(): return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
def jdir(i): return os.path.join(JOBS, i)
def load(i):
    with open(os.path.join(jdir(i), "job.json")) as f: return json.load(f)
def save(j):
    p = os.path.join(jdir(j["id"]), "job.json"); t = p + ".tmp"
    with open(t, "w") as f: json.dump(j, f, ensure_ascii=False, indent=1)
    os.replace(t, p)
def alive(pid):
    try: os.kill(pid, 0); return True
    except Exception: return False
def kind_of(src, media=False):
    if src.startswith("magnet:"): return "magnet"
    if media or MEDIA_HOSTS.match(src): return "media"
    if re.match(r"^(https?|ftp)://", src): return "url"
    if os.path.isfile(os.path.expanduser(src)): return "torrent"
    raise ValueError(f"unknown source (not magnet, URL or existing file): {src}")

def wifi_default():
    try:
        hw = subprocess.run(["networksetup", "-listallhardwareports"], capture_output=True, text=True).stdout
        m = re.search(r"Hardware Port: Wi-Fi\nDevice: (\S+)", hw)
        r = subprocess.run(["route", "-n", "get", "default"], capture_output=True, text=True).stdout
        m2 = re.search(r"interface: (\S+)", r)
        return bool(m and m2 and m.group(1) == m2.group(1))
    except Exception: return False
def night_ok():
    h = datetime.datetime.now().hour
    return (h >= 22 or h < 8) and wifi_default()

def pool_of(j): return "media" if j.get("kind") == "media" else "aria"
def pool_cap(pool): return MAX_MEDIA if pool == "media" else MAX_ARIA

def progress(j):
    lp = os.path.join(jdir(j["id"]), "aria2.log"); last = None
    try:
        with open(lp, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 20000))
            for line in f.read().decode("utf-8", "ignore").splitlines():
                m = PROG.search(line)
                if m: last = m
    except FileNotFoundError: pass
    if not last:
        try:
            with open(lp, "rb") as f:
                f.seek(0, 2); f.seek(max(0, f.tell() - 20000)); y = None
                for line in f.read().decode("utf-8", "ignore").splitlines():
                    m = YTP.search(line)
                    if m: y = m
            if y: return {"percent": int(float(y.group(1))), "total": y.group(2), "speed": y.group(3), "eta": y.group(4), "connections": None}
        except FileNotFoundError: pass
        return {}
    return {"done": last.group(1), "total": last.group(2), "percent": int(last.group(3)),
            "connections": int(last.group(4)), "seeds": int(last.group(5)) if last.group(5) else None,
            "speed": last.group(6) + "/s", "eta": last.group(7)}

def retry_limit(j):
    limit = j.get("max_retries")
    return limit if type(limit) is int else DEFAULT_RETRIES
def retry_delay(count):
    return RETRY_BACKOFFS[min(max(int(count), 1), len(RETRY_BACKOFFS)) - 1]
def recent_log(job_id):
    lp = os.path.join(jdir(job_id), "aria2.log")
    try:
        with open(lp, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 20000))
            text = f.read().decode("utf-8", "ignore")
    except OSError:
        return ""
    cut = text.rfind("==== start")
    return text[cut:] if cut >= 0 else text
def saw_bot_check(job_id):
    text = recent_log(job_id).replace("\u2019", "'").lower()
    return "sign in to confirm you're not a bot" in text
def load_config():
    path = os.path.join(BASE, "config.json")
    try:
        with open(path, encoding="utf-8") as f: data = json.load(f)
    except (OSError, ValueError, UnicodeError):
        return {}
    return data if isinstance(data, dict) else {}
def browser_for(j):
    """Browser spec for yt-dlp, never cookie contents. Flag > env > config > none."""
    for spec in (j.get("cookies_from_browser"), os.environ.get("ARIA_DL_COOKIES_FROM_BROWSER"),
                 load_config().get("cookies_from_browser")):
        if isinstance(spec, str) and spec.strip(): return spec.strip()
    return None
def mark_stopped(j, code):
    j["exit_code"] = code; j["pid"] = None; j["ended"] = now()
    if code == 0:
        j["next_retry_ts"] = j["next_retry_at"] = None
        j["last_error"] = None
        j["state"] = "complete"
        return
    if code in (None, 7):
        j["state"] = "waiting"
        return
    if j.get("kind") == "media" and saw_bot_check(j["id"]): j["last_error"] = "youtube_bot_check"
    elif j.get("last_error") == "youtube_bot_check": j["last_error"] = None
    limit = retry_limit(j); count = int(j.get("retry_count") or 0); j["max_retries"] = limit
    if limit > 0 and count < limit:
        count += 1
        ts = time.time() + retry_delay(count)
        j.update(retry_count=count, next_retry_ts=ts, state="retrying",
                 next_retry_at=datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S"))
        return
    j.update(retry_count=count, next_retry_ts=None, next_retry_at=None, state="failed")
def refresh(j):
    if j["state"] == "running":
        ec = os.path.join(jdir(j["id"]), "exitcode")
        if os.path.exists(ec) or not alive(j.get("pid") or 0):
            try: code = int(open(ec).read().strip()) if os.path.exists(ec) else None
            except Exception: code = None
            mark_stopped(j, code); save(j)
    return j

def start(j):
    d = jdir(j["id"]); os.makedirs(os.path.expanduser(j["dir"]), exist_ok=True)
    ec = os.path.join(d, "exitcode")
    if os.path.exists(ec): os.remove(ec)
    if j["kind"] == "media":
        args = ["yt-dlp", "--newline", "--continue", "--no-overwrites", "--embed-metadata",
                "--retries", "5", "--fragment-retries", "5", "--retry-sleep", "exp=1:30",
                "-o", os.path.join(os.path.expanduser(j["dir"]), "%(title).150B [%(id)s].%(ext)s")]
        if j.get("audio"): args += ["-x", "--audio-format", "m4a"]
        else: args += ["-f", "bv*[height<=?%s]+ba/b" % (j.get("max_height") or 1080), "--merge-output-format", "mp4"]
        if j.get("limit"): args += ["-r", j["limit"]]
        browser = browser_for(j)
        if browser: args += ["--cookies-from-browser", browser]
        elif os.path.exists(COOKIES): args += ["--cookies", COOKIES]
        args.append(j["source"])
        return launch(j, d, args)
    args = ["aria2c", "--continue=true", "--summary-interval=60", "--console-log-level=notice",
            "-d", os.path.expanduser(j["dir"])]
    if j["kind"] in ("magnet", "torrent") or j["source"].endswith(".torrent"):
        tr = ""
        try: tr = subprocess.run(["curl", "-fsSL", "--max-time", "20", TRACKERS_URL], capture_output=True, text=True).stdout.strip()
        except Exception: pass
        if tr: args.append("--bt-tracker=" + tr)
        args += ["--enable-dht=true", "--enable-peer-exchange=true", "--bt-enable-lpd=true",
                 "--peer-id-prefix=-TR2770-", "--user-agent=Transmission/2.77", "--peer-agent=Transmission/2.77",
                 "--bt-max-peers=100", "--seed-time=0", "--bt-save-metadata=true", "--follow-torrent=true"]
    else:
        args += ["-x8", "-s8", "-k1M", "--max-tries=0", "--retry-wait=30"]
    if j.get("limit"): args.append("--max-overall-download-limit=" + j["limit"])
    args.append(j.get("local_torrent") or j["source"])
    return launch(j, d, args)

def launch(j, d, args):
    log = open(os.path.join(d, "aria2.log"), "a")
    log.write(f"\n==== start {now()} ====\n"); log.flush()
    me = os.path.realpath(__file__)
    script = 'd="$1"; me="$2"; shift 2; cd "$d"; "$@"; rc=$?; echo $rc > exitcode.tmp && mv exitcode.tmp exitcode; "$me" tick >/dev/null 2>&1 || true; exit $rc'
    p = subprocess.Popen(["/bin/sh", "-c", script, "sh", d, me] + args, stdout=log, stderr=log,
                         stdin=subprocess.DEVNULL, start_new_session=True, env={**os.environ, "PATH": PATH})
    j.update(state="running", pid=p.pid, started=now()); save(j)

def stop(j, newstate):
    pid = j.get("pid")
    if pid and alive(pid):
        try: os.killpg(pid, signal.SIGINT)   # aria2 saves .aria2 control file on SIGINT
        except Exception: pass
        for _ in range(30):
            if not alive(pid): break
            time.sleep(1)
        if alive(pid):
            try: os.killpg(pid, signal.SIGKILL)
            except Exception: pass
    j.update(state=newstate, pid=None); save(j)

def view(j):
    v = {k: j.get(k) for k in ("id", "name", "kind", "source", "dir", "when", "state", "created", "started", "ended", "exit_code")}
    v["retry_count"] = int(j.get("retry_count") or 0)
    v["max_retries"] = retry_limit(j)
    v["next_retry_at"] = j.get("next_retry_at")
    v["last_error"] = j.get("last_error")
    v["cookies_from_browser"] = browser_for(j)
    v.update(progress(j))
    if j.get("state") == "complete": v.update(percent=100, done=v.get("total"), speed="0B/s", eta=None)
    return v
def retry_label(v):
    count = int(v.get("retry_count") or 0)
    limit = v.get("max_retries")
    if not count or limit is None: return ""
    if v.get("state") == "retrying":
        stamp = v.get("next_retry_at") or ""
        hhmm = ("@" + stamp[11:16]) if len(stamp) >= 16 else ""
        return f"retry {count}/{limit} {hhmm}".strip()
    if v.get("state") == "failed": return f"retry {count}/{limit}"
    return ""

def all_jobs():
    os.makedirs(JOBS, exist_ok=True)
    return [refresh(load(i)) for i in sorted(os.listdir(JOBS)) if os.path.exists(os.path.join(jdir(i), "job.json"))]

def find(i):
    ms = [x for x in os.listdir(JOBS) if x.startswith(i)] if os.path.isdir(JOBS) else []
    if len(ms) != 1: sys.exit(f"aria-dl: no unique job matching {i}")
    return refresh(load(ms[0]))

def tick():
    os.makedirs(BASE, exist_ok=True)
    with open(LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        jobs = all_jobs()
        night = None
        for j in jobs:
            if j["state"] == "running" and j["when"] == "night":
                if night is None: night = night_ok()
                if not night: stop(j, "waiting")
        running = {"media": 0, "aria": 0}
        for j in jobs:
            if j["state"] == "running": running[pool_of(j)] += 1
        # Prefer "now" jobs over "night" jobs, then older created first.
        # Due retries join the same queue; future retries stay "retrying".
        now_ts = time.time()
        def ready(j):
            if j["state"] in ("queued", "waiting"): return True
            ts = j.get("next_retry_ts")
            return j["state"] == "retrying" and type(ts) in (int, float) and ts <= now_ts
        candidates = [j for j in jobs if ready(j)]
        candidates.sort(key=lambda x: (0 if x.get("when") == "now" else 1, x.get("created_ts") or 0, x.get("created") or ""))
        for j in candidates:
            pool = pool_of(j)
            if running[pool] >= pool_cap(pool): continue
            if j["when"] == "night":
                if night is None: night = night_ok()
                if not night:
                    if j["state"] == "queued": j["state"] = "waiting"; save(j)
                    continue
            j["next_retry_ts"] = j["next_retry_at"] = None
            start(j)
            running[pool] += 1

def out(obj, as_json, hints=False):
    if as_json: print(json.dumps(obj, ensure_ascii=False, indent=1)); return
    rows = obj if isinstance(obj, list) else [obj]
    for v in rows:
        if v.get("percent") is not None:
            if v.get("done") is not None:
                pr = f"{v['percent']}% {v['done']}/{v.get('total','?')} {v.get('speed','')}"
            else:
                pr = f"{v['percent']}% {v.get('total','?')} {v.get('speed','')}"
            if v.get("connections") is not None:
                pr += f" peers:{v['connections']}"
        else:
            pr = ""
        label = retry_label(v)
        extra = f" {label}" if label else ""
        hint = "  hint: set --cookies-from-browser chrome" if hints and v.get("last_error") == "youtube_bot_check" else ""
        print(f"{v['id']}  {v['state']:<8} {v['when']:<5} {pr}{extra}  {v['name']}{hint}")

def collect_sources(o):
    raw = list(o.sources or [])
    from_batch = bool(o.file) or len(raw) > 1
    if o.file:
        f = sys.stdin if o.file == "-" else open(os.path.expanduser(o.file))
        with f:
            raw.extend(f.read().splitlines())
    elif not raw and not sys.stdin.isatty():
        from_batch = True
        raw.extend(sys.stdin.read().splitlines())
    seen, sources = set(), []
    for line in raw:
        s = line.strip()
        if not s or s.startswith("#"): continue
        if s not in seen:
            seen.add(s); sources.append(s)
    if not sources:
        sys.exit("aria-dl: no sources provided (pass URLs/files, --file FILE, or pipe via stdin)")
    return sources, from_batch

def add_one(raw_src, o, label=None):
    k = kind_of(raw_src, o.media)
    src = os.path.abspath(os.path.expanduser(raw_src)) if k == "torrent" else raw_src
    i = hashlib.sha1(src.encode()).hexdigest()[:8]
    if os.path.exists(os.path.join(jdir(i), "job.json")):
        j = refresh(load(i))
        if j["state"] not in ("complete", "running"):
            if j["state"] in ("failed", "retrying"):
                j["retry_count"] = 0
                j["next_retry_ts"] = j["next_retry_at"] = None
            if o.cookies_from_browser and o.cookies_from_browser.strip():
                j["cookies_from_browser"] = o.cookies_from_browser.strip()
            j.update(when=o.when, dir=o.dir, limit=o.limit or j.get("limit"),
                     audio=o.audio or j.get("audio"), max_height=o.max_height or j.get("max_height"),
                     max_retries=o.retries, state="queued")
            save(j)
    else:
        os.makedirs(jdir(i), exist_ok=True)
        default_name = (re.search(r"dn=([^&]+)", src) or [None, src[:60]])[1] if k == "magnet" else (os.path.basename(src)[:80] or src[:80])
        browser = o.cookies_from_browser.strip() if o.cookies_from_browser and o.cookies_from_browser.strip() else None
        j = {"id": i, "kind": k, "source": src, "dir": o.dir, "when": o.when, "limit": o.limit,
             "audio": o.audio, "max_height": o.max_height,
             "name": label or default_name, "retry_count": 0, "max_retries": o.retries,
             "next_retry_ts": None, "next_retry_at": None, "cookies_from_browser": browser,
             "state": "queued", "created": now(), "created_ts": time.time(), "pid": None}
        if k == "torrent":
            lt = os.path.join(jdir(i), "source.torrent"); shutil.copy(src, lt); j["local_torrent"] = lt
        save(j)
    return j["id"]

def main():
    ap = argparse.ArgumentParser(prog="aria-dl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    a = sp.add_parser("add")
    a.add_argument("sources", nargs="*", help="one or more .torrent paths, magnet links, or URLs")
    a.add_argument("-f", "--file", help="read sources from file (one per line, - for stdin)")
    a.add_argument("--dir", default="~/Downloads")
    a.add_argument("--when", choices=["now", "night"], default="now"); a.add_argument("--name"); a.add_argument("--limit")
    a.add_argument("--media", action="store_true", help="force yt-dlp for any video site URL")
    a.add_argument("--audio", action="store_true", help="media: audio only (m4a)")
    a.add_argument("--max-height", type=int, help="media: max video height, default 1080")
    a.add_argument("--retries", type=int, default=DEFAULT_RETRIES,
                   help="cross-process retries after a failed attempt (default %(default)s, env ARIA_DL_MAX_RETRIES; 0 disables)")
    a.add_argument("--cookies-from-browser", metavar="BROWSER[:PROFILE]",
                   help="yt-dlp browser cookies, e.g. chrome or 'chrome:Profile 1' (else env ARIA_DL_COOKIES_FROM_BROWSER, then config.json)")
    a.add_argument("--json", action="store_true")
    l = sp.add_parser("list"); l.add_argument("--json", action="store_true")
    for c in ("status", "pause"):
        p = sp.add_parser(c); p.add_argument("ids", nargs="+"); p.add_argument("--json", action="store_true")
    r = sp.add_parser("resume")
    r.add_argument("ids", nargs="+", help="job IDs and/or selectors: all, failed (includes retrying), paused")
    r.add_argument("--json", action="store_true")
    rm = sp.add_parser("remove")
    rm.add_argument("ids", nargs="+", help="job IDs and/or selectors: failed, complete (job records only)")
    rm.add_argument("--json", action="store_true")
    g = sp.add_parser("log"); g.add_argument("id"); g.add_argument("-n", type=int, default=20)
    sp.add_parser("tick")
    o = ap.parse_args()
    os.makedirs(JOBS, exist_ok=True)
    if o.cmd == "add" and o.retries < 0: sys.exit("aria-dl: --retries must be >= 0")
    try:
        dispatch(o)
    finally:
        arm_retry_wake()

def saved_jobs():
    os.makedirs(JOBS, exist_ok=True)
    found = []
    for i in os.listdir(JOBS):
        p = os.path.join(jdir(i), "job.json")
        if not os.path.isfile(p): continue
        try:
            with open(p) as f: found.append(json.load(f))
        except Exception: pass
    return found
def next_night_open(now_ts):
    dt = datetime.datetime.fromtimestamp(now_ts)
    if dt.hour >= 22 or dt.hour < 8: return None
    return dt.replace(hour=22, minute=0, second=0, microsecond=0).timestamp()
def retry_wake_at(jobs, now_ts):
    targets = []
    for j in jobs:
        if j.get("state") != "retrying": continue
        ts = j.get("next_retry_ts")
        if type(ts) not in (int, float): continue
        target = ts
        if j.get("when") == "night":
            opening = next_night_open(now_ts)
            if opening is not None: target = max(ts, opening)
        if target > now_ts + 0.5: targets.append(target)
    return min(targets) if targets else None
def read_wake():
    try:
        with open(WAKE) as f: return json.load(f)
    except Exception: return None
def silence_wake(info):
    pid = (info or {}).get("pid")
    if pid and pid != os.getpid() and alive(pid):
        try: os.killpg(pid, signal.SIGTERM)
        except Exception: pass
    if os.path.exists(WAKE):
        try: os.remove(WAKE)
        except Exception: pass
def arm_retry_wake():
    os.makedirs(BASE, exist_ok=True)
    with open(LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        now_ts = time.time()
        when = retry_wake_at(saved_jobs(), now_ts)
        info = read_wake()
        if info and info.get("pid") == os.getpid():
            info = None
            if os.path.exists(WAKE):
                try: os.remove(WAKE)
                except Exception: pass
        if when is None:
            silence_wake(info); return
        if info and alive(info.get("pid") or 0) and type(info.get("at")) in (int, float):
            if now_ts - 1 <= info["at"] <= when + 1: return
            silence_wake(info)
        delay = max(1, int(when - now_ts) + 1)
        token = "t" + os.urandom(8).hex()
        me = os.path.realpath(__file__)
        p = subprocess.Popen(["/bin/sh", "-c", WAKE_SCRIPT, "wake", str(delay), WAKE, token, me],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True, env={**os.environ, "PATH": PATH})
        tmp = WAKE + ".tmp"
        with open(tmp, "w") as f: json.dump({"pid": p.pid, "at": when, "token": token}, f)
        os.replace(tmp, WAKE)

RESUME_SELECTORS = {
    "all": ("paused", "failed", "waiting", "retrying"),
    "failed": ("failed", "retrying"),
    "paused": ("paused",),
}
REMOVE_SELECTORS = {"failed": ("failed",), "complete": ("complete",)}
def pick_targets(tokens, table):
    jobs = all_jobs()
    chosen, seen, labels, named = [], set(), [], False
    for tok in tokens:
        if tok not in labels: labels.append(tok)
        if tok in table:
            named = True
            for j in jobs:
                if j["state"] in table[tok] and j["id"] not in seen:
                    chosen.append(j); seen.add(j["id"])
        else:
            j = find(tok)
            if j["id"] not in seen:
                chosen.append(j); seen.add(j["id"])
    return chosen, labels, named
def bulk_line(verb, n, labels):
    return f"{verb} {n} {'job' if n == 1 else 'jobs'} ({', '.join(labels)})"
def no_match(as_json):
    print("[]" if as_json else "no jobs matched")
def queue_resume(j):
    if j["state"] in ("failed", "retrying"): j["retry_count"] = 0
    j["next_retry_ts"] = j["next_retry_at"] = None
    j["state"] = "queued"
    save(j)
def dispatch(o):
    if o.cmd == "add":
        sources, from_batch = collect_sources(o)
        ids, errors = [], []
        for idx, s in enumerate(sources, 1):
            label = f"{o.name} #{idx}" if (o.name and len(sources) > 1) else o.name
            try:
                ids.append(add_one(s, o, label=label))
            except Exception as e:
                errors.append({"source": s, "error": str(e)})
                print(f"aria-dl: error adding {s}: {e}", file=sys.stderr)
        if ids: tick()
        views = [view(refresh(load(i))) for i in ids]
        if from_batch:
            if o.json: out(views + errors if errors else views, True)
            else: out(views, False)
        elif views:
            out(views[0], o.json)
        if errors: sys.exit(1)
    elif o.cmd == "list": out([view(j) for j in all_jobs()], o.json)
    elif o.cmd == "status":
        views = [view(find(i)) for i in o.ids]
        out(views if len(views) > 1 else views[0], o.json, hints=True)
    elif o.cmd == "pause":
        targets = [j for j in all_jobs() if j["state"] in ("running", "queued", "waiting", "retrying")] if o.ids == ["all"] else [find(i) for i in o.ids]
        for j in targets:
            stop(j, "paused")
            j["next_retry_ts"] = j["next_retry_at"] = None
            save(j)
        views = [view(j) for j in targets]
        out(views if (len(o.ids) > 1 or o.ids == ["all"]) else (views[0] if views else []), o.json)
    elif o.cmd == "resume":
        pure_all = o.ids == ["all"]
        targets, labels, named = pick_targets(o.ids, RESUME_SELECTORS)
        if not targets:
            if named or pure_all: no_match(o.json)
        else:
            for j in targets: queue_resume(j)
            tick()
            views = [view(refresh(load(j["id"]))) for j in targets]
            if named and not pure_all:
                if o.json: out(views, True)
                else: print(bulk_line("resumed", len(views), labels))
            else:
                out(views if (len(o.ids) > 1 or pure_all) else views[0], o.json)
    elif o.cmd == "remove":
        targets, labels, named = pick_targets(o.ids, REMOVE_SELECTORS)
        if named and not targets:
            no_match(o.json)
        else:
            views = []
            for j in targets:
                stop(j, "removed"); views.append(view(j)); shutil.rmtree(jdir(j["id"]))
                if not named and not o.json:
                    print(f"removed job {j['id']} (files kept in {j['dir']})")
            if targets: tick()
            if named:
                if o.json: out(views, True)
                else: print(bulk_line("removed", len(views), labels))
            elif o.json:
                out(views if len(views) > 1 else views[0], True)
    elif o.cmd == "log":
        j = find(o.id); subprocess.run(["tail", f"-n{o.n}", os.path.join(jdir(j["id"]), "aria2.log")])
    elif o.cmd == "tick": tick()

if __name__ == "__main__": main()
