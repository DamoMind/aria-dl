WAKE = os.path.join(BASE, ".retry-wake.json")
# Sleep, drop this wake record only if its token is still current, then exec tick.
# Deleting first keeps tick from observing its own pid; a replaced sleeper keeps its record.
WAKE_SCRIPT = (
    'sleep "$1"; wake="$2"; token="$3"; me="$4"; cur=""; '
    '[ -f "$wake" ] && cur=$(cat "$wake"); '
    'case "$cur" in *"$token"*) rm -f "$wake";; esac; '
    'exec "$me" tick'
)

def now(): return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

def emit(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=1), flush=True)

def redact(text):
    """Drop URL userinfo and header secrets. The source URL's query string is kept."""
    if text is None: return None
    text = str(text)
    text = re.sub(r"([a-zA-Z][a-zA-Z0-9+.-]*://)[^/\s:@]+:[^/\s@]+@", r"\1", text)
    text = re.sub(r"(?i)(^|[\s;])((?:cookie|authorization)\s*[:=]\s*)\S+", r"\1\2[redacted]", text)
    return text

def fail(code, error, message, hint=None):
    message = redact(message)
    if hint: hint = redact(hint)
    if OUT_JSON or GLOBAL_JSON or env_on("ARIA_DL_JSON"):
        payload = {"ok": False, "error": error, "message": message}
        if hint: payload["hint"] = hint
        emit(payload)
    print("aria-dl: " + message, file=sys.stderr)
    if hint: print(hint, file=sys.stderr)
    sys.exit(code)

def tool_path():
    if "ARIA_DL_PATH" in os.environ:
        base = os.environ.get("ARIA_DL_PATH") or ""
    else:
        base = DEFAULT_PATH
    parts = []
    for chunk in (base, os.environ.get("PATH", "")):
        for p in chunk.split(os.pathsep):
            if p and p not in parts: parts.append(p)
    return os.pathsep.join(parts)

def child_env():
    """Prefer known tool locations, then the caller PATH. Do not set proxy variables."""
    return {**os.environ, "PATH": tool_path()}

def tool_ok(name):
    return shutil.which(name, path=child_env()["PATH"]) is not None

def parse_size(text):
    if text is None: return None
    m = re.match(r"^\s*([\d.]+)\s*([kmgtp]?i?b)?\s*$", str(text), re.I)
    if not m: return None
    try: num = float(m.group(1))
    except ValueError: return None
    unit = (m.group(2) or "b").lower()
    mult = {
        "b": 1,
        "kb": 1000, "mb": 1000 ** 2, "gb": 1000 ** 3, "tb": 1000 ** 4,
        "kib": 1024, "mib": 1024 ** 2, "gib": 1024 ** 3, "tib": 1024 ** 4,
    }
    if unit not in mult: return None
    return int(num * mult[unit])

def blank_progress():
    return {
        "percent": None, "done": None, "total": None,
        "done_bytes": None, "total_bytes": None,
        "speed": None, "eta": None, "connections": None, "seeds": None,
    }

def fill_bytes(p):
    done_b = parse_size(p.get("done")) if p.get("done") else None
    total_b = parse_size(p.get("total")) if p.get("total") else None
    if done_b is None and total_b is not None and isinstance(p.get("percent"), int):
        done_b = int(total_b * (p["percent"] / 100.0))
    p["done_bytes"] = done_b
    p["total_bytes"] = total_b
    return p

DEST_RES = (
    re.compile(r"\[download\] Destination: (.+)$"),
    re.compile(r"\[ExtractAudio\] Destination: (.+)$"),
    re.compile(r'\[Merger\] Merging formats into "(.+)"'),
    re.compile(r'\[MoveFiles\] Moving file ".+" to "(.+)"'),
    re.compile(r"^Download complete: (.+)$"),
)
NET_MARKERS = (
    "network is unreachable",
    "connection reset",
    "temporary failure in name resolution",
    "name or service not known",
    "no route to host",
    "connection refused",
    "timed out",
    "unable to download api page",
)
def jdir(i): return os.path.join(JOBS, i)
def load(i):
    with open(os.path.join(jdir(i), "job.json")) as f: return json.load(f)
def save(j):
    p = os.path.join(jdir(j["id"]), "job.json"); t = p + ".tmp"
    with open(t, "w") as f: json.dump(j, f, ensure_ascii=False, indent=1)
    os.replace(t, p)
def alive(pid):
    try: os.kill(pid, 0); return True
    except Exception: return False
def kind_of(src, media=False):
    if src.startswith("magnet:"): return "magnet"
    if media or MEDIA_HOSTS.match(src): return "media"
    if re.match(r"^(https?|ftp)://", src): return "url"
    if os.path.isfile(os.path.expanduser(src)): return "torrent"
    raise ValueError(f"unknown source (not magnet, URL or existing file): {src}")

def wifi_default():
    try:
        hw = subprocess.run(["networksetup", "-listallhardwareports"], capture_output=True, text=True).stdout
        m = re.search(r"Hardware Port: Wi-Fi\nDevice: (\S+)", hw)
        r = subprocess.run(["route", "-n", "get", "default"], capture_output=True, text=True).stdout
        m2 = re.search(r"interface: (\S+)", r)
        return bool(m and m2 and m.group(1) == m2.group(1))
    except Exception: return False
def night_ok():
    h = datetime.datetime.now().hour
    return (h >= 22 or h < 8) and wifi_default()

def pool_of(j): return "media" if j.get("kind") == "media" else "aria"
def pool_cap(pool): return MAX_MEDIA if pool == "media" else MAX_ARIA

def progress(j):
    lp = os.path.join(jdir(j["id"]), "aria2.log"); last = None
    try:
        with open(lp, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 20000))
            for line in f.read().decode("utf-8", "ignore").splitlines():
                m = PROG.search(line)
                if m: last = m
    except FileNotFoundError: pass
    if not last:
        try:
            with open(lp, "rb") as f:
                f.seek(0, 2); f.seek(max(0, f.tell() - 20000)); y = None
                for line in f.read().decode("utf-8", "ignore").splitlines():
                    m = YTP.search(line)
                    if m: y = m
            if y: return {"percent": int(float(y.group(1))), "total": y.group(2), "speed": y.group(3), "eta": y.group(4), "connections": None}
        except FileNotFoundError: pass
        return {}
    return {"done": last.group(1), "total": last.group(2), "percent": int(last.group(3)),
            "connections": int(last.group(4)), "seeds": int(last.group(5)) if last.group(5) else None,
            "speed": last.group(6) + "/s", "eta": last.group(7)}

def retry_limit(j):
    limit = j.get("max_retries")
    return limit if type(limit) is int else DEFAULT_RETRIES
def retry_delay(count):
    return RETRY_BACKOFFS[min(max(int(count), 1), len(RETRY_BACKOFFS)) - 1]
def recent_log(job_id):
    lp = os.path.join(jdir(job_id), "aria2.log")
    try:
        with open(lp, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 20000))
            text = f.read().decode("utf-8", "ignore")
    except OSError:
        return ""
    cut = text.rfind("==== start")
    return text[cut:] if cut >= 0 else text
def saw_bot_check(job_id):
    text = recent_log(job_id).replace("\u2019", "'").lower()
    return "sign in to confirm you're not a bot" in text
def saw_network(job_id):
    text = recent_log(job_id).lower()
    return any(m in text for m in NET_MARKERS)
def output_paths(job_id):
    found = []
    for line in recent_log(job_id).splitlines():
        line = line.strip()
        for pat in DEST_RES:
            m = pat.search(line)
            if not m: continue
            path = redact(m.group(1).strip().strip('"'))
            if path and path not in found: found.append(path)
            break
    return found
def load_config():
    path = os.path.join(BASE, "config.json")
    try:
        with open(path, encoding="utf-8") as f: data = json.load(f)
    except (OSError, ValueError, UnicodeError):
        return {}
    return data if isinstance(data, dict) else {}
def browser_for(j):
    """Browser spec for yt-dlp, never cookie contents. Flag > env > config > none."""
    for spec in (j.get("cookies_from_browser"), os.environ.get("ARIA_DL_COOKIES_FROM_BROWSER"),
                 load_config().get("cookies_from_browser")):
        if isinstance(spec, str) and spec.strip(): return spec.strip()
    return None
def save_config(data):
    path = os.path.join(BASE, "config.json")
    os.makedirs(BASE, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
def is_youtube(src):
    return bool(src and YOUTUBE_HOSTS.match(src))
def proxy_disabled(value):
    return str(value).strip().lower() in ("", "none")
def resolved_proxy(j):
    """URL for this media job, or None to go direct. Job flag, then env, then config."""
    if j.get("proxy") is not None:
        raw = str(j.get("proxy")).strip()
        return None if proxy_disabled(raw) else raw
    cfg = load_config()
    youtube = is_youtube(j.get("source") or "")
    candidates = []
    if youtube and os.environ.get("ARIA_DL_YOUTUBE_PROXY") is not None:
        candidates.append(os.environ.get("ARIA_DL_YOUTUBE_PROXY"))
    if os.environ.get("ARIA_DL_PROXY") is not None:
        candidates.append(os.environ.get("ARIA_DL_PROXY"))
    if youtube and isinstance(cfg.get("youtube_proxy"), str):
        candidates.append(cfg.get("youtube_proxy"))
    if isinstance(cfg.get("proxy"), str):
        candidates.append(cfg.get("proxy"))
    for raw in candidates:
        raw = raw.strip()
        return None if proxy_disabled(raw) else raw
    return None
def proxy_hostport(url):
    """host:port only. Userinfo is dropped and never returned."""
    if not url: return None
    parsed = urlparse(url if "://" in url else "http://" + url)
    host = parsed.hostname
    if not host: return None
    if parsed.port: return "%s:%s" % (host, parsed.port)
    return host
def proxy_reachable(url, timeout=2):
    parsed = urlparse(url if "://" in url else "http://" + url)
    host = parsed.hostname
    if not host: return False
    port = parsed.port
    if port is None:
        port = {"https": 443, "socks5": 1080, "socks5h": 1080, "socks4": 1080, "socks4a": 1080}.get(parsed.scheme, 80)
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False
BROWSERS = ("chrome", "brave", "edge", "firefox", "safari", "vivaldi")
LOGIN_COOKIE_NAMES = ("SAPISID", "__Secure-3PSID", "LOGIN_INFO")
COOKIE_REFRESH_STAMP = os.path.join(BASE, ".cookies-refresh-ts")
BROWSER_PROFILE_DIRS = {
    "chrome": ("Library/Application Support/Google/Chrome", ".config/google-chrome"),
    "brave": ("Library/Application Support/BraveSoftware/Brave-Browser", ".config/BraveSoftware/Brave-Browser"),
    "edge": ("Library/Application Support/Microsoft Edge", ".config/microsoft-edge"),
    "firefox": ("Library/Application Support/Firefox", ".mozilla/firefox"),
    "safari": ("Library/Containers/com.apple.Safari", "Library/Safari"),
    "vivaldi": ("Library/Application Support/Vivaldi", ".config/vivaldi"),
}
TCC_HINT = (
    "Run `aria-dl cookies refresh` once from Terminal and allow the \"access data from other apps\" prompt, "
    "or grant Terminal Full Disk Access. Chrome will ask for Keychain \"Chrome Safe Storage\" access; click Always Allow."
)
def split_spec(spec):
    spec = (spec or "").strip()
    name, sep, profile = spec.partition(":")
    return name.lower(), (profile if sep else "")
def spec_for(name, profile):
    return name if not profile else name + ":" + profile
def default_cookie_browser():
    return browser_for({}) or "auto"
def browser_profile_dir(name):
    home = os.path.expanduser("~")
    for rel in BROWSER_PROFILE_DIRS.get(name, ()):
        path = os.path.join(home, rel)
        if os.path.isdir(path): return path
    return None
def tcc_blocked(text, browser):
    low = (text or "").lower()
    if "operation not permitted" in low: return True
    name = split_spec(browser or "")[0]
    if "could not find" in low and "cookies database" in low and name in BROWSERS and browser_profile_dir(name):
        return True
    return False
def domain_ok(domain):
    d = (domain or "").lower().lstrip(".")
    return d == "youtube.com" or d.endswith(".youtube.com") or d == "google.com" or d.endswith(".google.com")
def parse_netscape(text):
    rows = []
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line: continue
        body = line[len("#HttpOnly_"):] if line.startswith("#HttpOnly_") else line
        if body.startswith("#"): continue
        parts = body.split("\t")
        if len(parts) < 7: continue
        if not domain_ok(parts[0]): continue
        try: exp = int(parts[4])
        except ValueError: exp = 0
        rows.append({"line": line, "domain": parts[0], "expiry": exp, "name": parts[5]})
    return rows
def login_present(rows):
    names = {r["name"] for r in rows}
    return any(n in names for n in LOGIN_COOKIE_NAMES)
def netscape_text(rows):
    lines = ["# Netscape HTTP Cookie File", "# Generated by aria-dl. Do not share this file.", ""]
    lines.extend(r["line"] for r in rows)
    return "\n".join(lines) + ("\n" if rows else "")
def cookies_write_path():
    if os.path.islink(COOKIES): return os.path.realpath(COOKIES)
    return COOKIES
def write_cookie_file(text):
    dest = cookies_write_path()
    parent = os.path.dirname(dest)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    try: os.chmod(parent, 0o700)
    except OSError: pass
    tmp = dest + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
        os.chmod(dest, 0o600)
    except Exception:
        try: os.remove(tmp)
        except OSError: pass
        raise
def run_cmd(args):
    path = os.environ["ARIA_DL_PATH"] if "ARIA_DL_PATH" in os.environ else DEFAULT_PATH
    return subprocess.run(args, capture_output=True, text=True, env={**os.environ, "PATH": path})
def export_browser(spec):
    parent = os.path.join(BASE, "cookies")
    os.makedirs(parent, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".ck-", dir=parent)
    os.close(fd)
    os.chmod(tmp, 0o600)
    try:
        proc = run_cmd(["yt-dlp", "--cookies-from-browser", spec, "--cookies", tmp,
                        "--skip-download", "--no-warnings", "--playlist-items", "0", "https://www.youtube.com/"])
        err = (getattr(proc, "stderr", "") or "") + "\n" + (getattr(proc, "stdout", "") or "")
        name = split_spec(spec)[0]
        if tcc_blocked(err, name): return None, "tcc"
        try:
            with open(tmp, encoding="utf-8", errors="replace") as f: raw = f.read()
        except OSError: raw = ""
        rows = parse_netscape(raw)
        if not rows: return None, "empty"
        return rows, "ok"
    finally:
        try: os.remove(tmp)
        except OSError: pass
def perform_refresh(spec):
    name, profile = split_spec(spec)
    if name == "auto":
        specs = [spec_for(b, profile) for b in BROWSERS]
    elif name in BROWSERS:
        specs = [spec_for(name, profile)]
    else:
        return {"ok": False, "error": "bad-browser", "browser": spec}
    saw_tcc = None
    saw_other = False
    for s in specs:
        rows, kind = export_browser(s)
        b = split_spec(s)[0]
        if kind == "tcc":
            if saw_tcc is None: saw_tcc = b
            if name != "auto": return {"ok": False, "error": "tcc", "browser": b}
            continue
        saw_other = True
        if kind != "ok":
            if name != "auto": return {"ok": False, "error": "empty", "browser": b}
            continue
        logged_in = login_present(rows)
        if name == "auto" and not logged_in: continue
        write_cookie_file(netscape_text(rows))
        return {"ok": True, "browser": b, "cookie_count": len(rows), "login": logged_in, "path": cookies_write_path()}
    if name == "auto" and saw_tcc and not saw_other:
        return {"ok": False, "error": "tcc", "browser": saw_tcc}
    if name == "auto":
        return {"ok": False, "error": "no-login", "browser": "auto"}
    return {"ok": False, "error": "empty", "browser": name}
def emit_refresh(result, as_json):
    if as_json:
        safe = {k: result[k] for k in ("ok", "error", "browser", "cookie_count", "login", "path") if k in result and result[k] is not None}
        if result.get("error") == "tcc": safe["hint"] = TCC_HINT
        print(json.dumps(safe, ensure_ascii=False, indent=1))
    elif result.get("ok"):
        print("imported %d youtube/google cookies from %s (login: %s)" % (result["cookie_count"], result["browser"], "yes" if result["login"] else "no"))
        print("wrote %s" % result["path"])
    elif result.get("error") == "tcc":
        print("aria-dl: cannot read %s cookies." % (result.get("browser") or "browser"))
        print(TCC_HINT)
    elif result.get("error") == "no-login":
        print("aria-dl: no logged-in YouTube session found.")
    elif result.get("error") == "bad-browser":
        print("aria-dl: browser must be auto, chrome, brave, edge, firefox, safari, or vivaldi")
    else:
        print("aria-dl: no YouTube or Google cookies exported from %s." % result.get("browser"))
    if not result.get("ok"): sys.exit(1)
def cookies_status():
    link = os.path.islink(COOKIES)
    path = cookies_write_path() if link else COOKIES
    info = {"path": path, "exists": False, "mtime": None, "age_seconds": None, "cookie_count": 0, "login": False, "earliest_expiry": None, "hint": None}
    target = path if os.path.isfile(path) else None
    if not target:
        info["hint"] = cookie_hint(info)
        return info
    st = os.stat(target)
    info.update(exists=True, path=target, mtime=datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
                age_seconds=max(0, int(time.time() - st.st_mtime)))
    try:
        with open(target, encoding="utf-8", errors="replace") as f: rows = parse_netscape(f.read())
    except OSError: rows = []
    info["cookie_count"] = len(rows)
    info["login"] = login_present(rows)
    exps = [r["expiry"] for r in rows if r["expiry"] > 0]
    if exps: info["earliest_expiry"] = datetime.datetime.fromtimestamp(min(exps)).strftime("%Y-%m-%d %H:%M:%S")
    info["hint"] = cookie_hint(info)
    return info
def cookie_hint(info):
    if not info.get("exists"):
        return "No cookies file yet. Run `aria-dl cookies refresh` in a terminal. macOS background jobs cannot read the browser."
    if not info.get("login"):
        return "No YouTube login cookie in the file. Run `aria-dl cookies refresh` from a terminal where you are signed in."
    return None
def format_age(secs):
    if secs < 60: return "%ds" % secs
    if secs < 3600: return "%dm" % (secs // 60)
    if secs < 86400: return "%dh" % (secs // 3600)
    return "%dd" % (secs // 86400)
def print_cookies_status(info):
    if not info["exists"]:
        print("cookies: no file at %s" % info["path"]); return
    print("cookies: %s" % info["path"])
    print("mtime: %s  age: %s" % (info["mtime"], format_age(info["age_seconds"])))
    print("count: %d  login: %s  earliest expiry: %s" % (info["cookie_count"], "yes" if info["login"] else "no", info["earliest_expiry"] or "none"))
def maybe_refresh_cookies():
    try: last = float(open(COOKIE_REFRESH_STAMP).read().strip())
    except Exception: last = 0
    if time.time() - last < 3600: return False
    try:
        os.makedirs(BASE, exist_ok=True)
        tmp = COOKIE_REFRESH_STAMP + ".tmp"
        with open(tmp, "w") as f: f.write(str(time.time()))
        os.replace(tmp, COOKIE_REFRESH_STAMP)
    except OSError: return False
    try:
        return bool(perform_refresh(default_cookie_browser()).get("ok"))
    except Exception: return False
def cookies_db_blocked(job_id, browser_spec):
    return tcc_blocked(recent_log(job_id), split_spec(browser_spec or "")[0])
def mark_stopped(j, code):
    j["exit_code"] = code; j["pid"] = None; j["ended"] = now()
    if code == 0:
        j["next_retry_ts"] = j["next_retry_at"] = None
        j["last_error"] = None
        j["state"] = "complete"
        return
    if code in (None, 7):
        j["state"] = "waiting"
        return
    browser = browser_for(j) if j.get("kind") == "media" else None
    if browser and os.path.isfile(COOKIES) and cookies_db_blocked(j["id"], browser):
        j["cookies_use_file"] = True
        j["last_error"] = None
        j["state"] = "queued"
        return
    if j.get("kind") == "media" and saw_bot_check(j["id"]):
        j["last_error"] = "youtube_bot_check"
        maybe_refresh_cookies()
    elif saw_network(j["id"]):
        j["last_error"] = "network"
    elif j.get("last_error") in ("youtube_bot_check", "network"):
        j["last_error"] = None
    limit = retry_limit(j); count = int(j.get("retry_count") or 0); j["max_retries"] = limit
    if limit > 0 and count < limit:
        count += 1
        ts = time.time() + retry_delay(count)
        j.update(retry_count=count, next_retry_ts=ts, state="retrying",
                 next_retry_at=datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S"))
        return
    j.update(retry_count=count, next_retry_ts=None, next_retry_at=None, state="failed")
def refresh(j):
    if j["state"] == "running":
        ec = os.path.join(jdir(j["id"]), "exitcode")
        if os.path.exists(ec) or not alive(j.get("pid") or 0):
            try: code = int(open(ec).read().strip()) if os.path.exists(ec) else None
            except Exception: code = None
            mark_stopped(j, code); save(j)
    return j

def mark_dependency(j, tool):
    j.update(state="failed", pid=None, ended=now(), exit_code=None,
             last_error="dependency_missing", missing_tool=tool,
             next_retry_ts=None, next_retry_at=None)
    save(j)

def start(j):
    need = "yt-dlp" if j["kind"] == "media" else "aria2c"
    if not tool_ok(need):
        mark_dependency(j, need)
        return
    d = jdir(j["id"]); os.makedirs(os.path.expanduser(j["dir"]), exist_ok=True)
    ec = os.path.join(d, "exitcode")
    if os.path.exists(ec): os.remove(ec)
    if j["kind"] == "media":
        args = ["yt-dlp", "--newline", "--continue", "--no-overwrites", "--embed-metadata",
                "--retries", "5", "--fragment-retries", "5", "--retry-sleep", "exp=1:30",
                "-o", os.path.join(os.path.expanduser(j["dir"]), "%(title).150B [%(id)s].%(ext)s")]
        if j.get("audio"): args += ["-x", "--audio-format", "m4a"]
        else: args += ["-f", "bv*[height<=?%s]+ba/b" % (j.get("max_height") or 1080), "--merge-output-format", "mp4"]
        if j.get("limit"): args += ["-r", j["limit"]]
        use_file = bool(j.get("cookies_use_file"))
        if use_file: j["cookies_use_file"] = False
        browser = None if use_file else browser_for(j)
        if browser: args += ["--cookies-from-browser", browser]
        elif os.path.exists(COOKIES): args += ["--cookies", COOKIES]
        proxy = resolved_proxy(j)
        if proxy and proxy_reachable(proxy):
            args += ["--proxy", proxy]
            j["proxy_used"] = proxy_hostport(proxy)
        else:
            if proxy:
                with open(os.path.join(d, "aria2.log"), "a", encoding="utf-8") as log:
                    log.write("proxy unreachable, falling back to direct\n")
            j["proxy_used"] = None
        args.append(j["source"])
        return launch(j, d, args)
    args = ["aria2c", "--continue=true", "--summary-interval=60", "--console-log-level=notice",
            "-d", os.path.expanduser(j["dir"])]
    if j["kind"] in ("magnet", "torrent") or j["source"].endswith(".torrent"):
        tr = ""
        try: tr = subprocess.run(["curl", "-fsSL", "--max-time", "20", TRACKERS_URL], capture_output=True, text=True).stdout.strip()
        except Exception: pass
        if tr: args.append("--bt-tracker=" + tr)
        args += ["--enable-dht=true", "--enable-peer-exchange=true", "--bt-enable-lpd=true",
                 "--peer-id-prefix=-TR2770-", "--user-agent=Transmission/2.77", "--peer-agent=Transmission/2.77",
                 "--bt-max-peers=100", "--seed-time=0", "--bt-save-metadata=true", "--follow-torrent=true"]
    else:
        args += ["-x8", "-s8", "-k1M", "--max-tries=0", "--retry-wait=30"]
    if j.get("limit"): args.append("--max-overall-download-limit=" + j["limit"])
    args.append(j.get("local_torrent") or j["source"])
    return launch(j, d, args)

def launch(j, d, args):
    log = open(os.path.join(d, "aria2.log"), "a")
    log.write(f"\n==== start {now()} ====\n"); log.flush()
    me = os.path.realpath(__file__)
    script = 'd="$1"; me="$2"; shift 2; cd "$d"; "$@"; rc=$?; echo $rc > exitcode.tmp && mv exitcode.tmp exitcode; "$me" tick >/dev/null 2>&1 || true; exit $rc'
    try:
        p = subprocess.Popen(["/bin/sh", "-c", script, "sh", d, me] + args, stdout=log, stderr=log,
                             stdin=subprocess.DEVNULL, start_new_session=True, env=child_env())
    except OSError as e:
        log.write("failed to start %s\n" % args[0]); log.close()
        if e.errno == errno.ENOENT: mark_dependency(j, args[0])
        else:
            j.update(state="failed", pid=None, ended=now(), exit_code=None, last_error="failed",
                     next_retry_ts=None, next_retry_at=None)
            save(j)
        return
    j.update(state="running", pid=p.pid, started=now()); save(j)

def stop(j, newstate):
    pid = j.get("pid")
    if pid and alive(pid):
        try: os.killpg(pid, signal.SIGINT)   # aria2 saves .aria2 control file on SIGINT
        except Exception: pass
        for _ in range(30):
            if not alive(pid): break
            time.sleep(1)
        if alive(pid):
            try: os.killpg(pid, signal.SIGKILL)
            except Exception: pass
    j.update(state=newstate, pid=None); save(j)

def view(j):
    v = {k: j.get(k) for k in ("id", "name", "kind", "source", "dir", "when", "state", "created", "started", "ended", "exit_code")}
    shown = redact(j.get("source") or "")
    v["source"] = shown or None
    v["name"] = redact(j.get("name")) if j.get("name") else j.get("name")
    v["url"] = shown if shown.startswith("magnet:") or re.match(r"^[a-z][a-z0-9+.-]*://", shown, re.I) else None
    v["retry_count"] = int(j.get("retry_count") or 0)
    v["max_retries"] = retry_limit(j)
    v["next_retry_at"] = j.get("next_retry_at")
    v["last_error"] = j.get("last_error")
    v["missing_tool"] = j.get("missing_tool")
    v["cookies_from_browser"] = browser_for(j)
    raw_proxy = j.get("proxy_used") if "proxy_used" in j else resolved_proxy(j)
    v["proxy"] = proxy_hostport(raw_proxy) if raw_proxy else None
    v["proxy_configured"] = bool(resolved_proxy(j))
    prog = blank_progress()
    prog.update(progress(j))
    if j.get("state") == "complete":
        prog["percent"] = 100
        if prog.get("total"): prog["done"] = prog["total"]
        prog["speed"] = "0B/s"
        prog["eta"] = None
    fill_bytes(prog)
    v.update(prog)
    v["progress"] = dict(prog)
    v["bytes"] = {"done": prog.get("done_bytes"), "total": prog.get("total_bytes")}
    v["output_paths"] = output_paths(j["id"])
    v["hint"] = job_hint(v)
    return v
def job_hint(v):
    state = v.get("state")
    err = v.get("last_error")
    jid = v.get("id") or ""
    if err == "youtube_bot_check":
        extra = ""
        if not v.get("proxy_configured"):
            extra = " Or set a yt-dlp proxy: aria-dl config set youtube_proxy http://127.0.0.1:PORT"
        return "YouTube asked for a sign-in. Run `aria-dl cookies refresh` in a terminal." + extra
    if err == "dependency_missing":
        tool = v.get("missing_tool") or "aria2c or yt-dlp"
        return "Missing %s. Install it, then `aria-dl resume %s`." % (tool, jid)
    if err == "network":
        return "Network error. Remaining attempts retry on their own; otherwise `aria-dl resume %s`." % jid
    if state == "failed":
        return "Failed. Read `aria-dl log %s`, then `aria-dl resume %s`." % (jid, jid)
    if state == "retrying":
        return "Retry scheduled at %s." % (v.get("next_retry_at") or "the scheduled time")
    if state == "waiting":
        return "Waiting for the night window (22:00-08:00) on Wi-Fi."
    if state == "paused":
        return "Paused. `aria-dl resume %s` continues it." % jid
    if state == "queued":
        return "Queued until a download slot is free."
    return None
def retry_label(v):
    count = int(v.get("retry_count") or 0)
    limit = v.get("max_retries")
    if not count or limit is None: return ""
    if v.get("state") == "retrying":
        stamp = v.get("next_retry_at") or ""
        hhmm = ("@" + stamp[11:16]) if len(stamp) >= 16 else ""
        return f"retry {count}/{limit} {hhmm}".strip()
    if v.get("state") == "failed": return f"retry {count}/{limit}"
    return ""

def all_jobs():
    os.makedirs(JOBS, exist_ok=True)
    return [refresh(load(i)) for i in sorted(os.listdir(JOBS)) if os.path.exists(os.path.join(jdir(i), "job.json"))]

def find(i):
    ms = [x for x in os.listdir(JOBS) if x.startswith(i)] if os.path.isdir(JOBS) else []
    if len(ms) == 1: return refresh(load(ms[0]))
    if len(ms) == 0:
        fail(EXIT_NOT_FOUND, "not_found", "no job matching %s" % i, "Run aria-dl list to see ids.")
    fail(EXIT_NOT_FOUND, "not_found", "no unique job matching %s (%d matches)" % (i, len(ms)), "Pass a longer id prefix.")

def tick():
    os.makedirs(BASE, exist_ok=True)
    with open(LOCK, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        jobs = all_jobs()
        night = None
        for j in jobs:
            if j["state"] == "running" and j["when"] == "night":
                if night is None: night = night_ok()
                if not night: stop(j, "waiting")
        running = {"media": 0, "aria": 0}
        for j in jobs:
            if j["state"] == "running": running[pool_of(j)] += 1
        # Prefer "now" jobs over "night" jobs, then older created first.
        # Due retries join the same queue; future retries stay "retrying".
        now_ts = time.time()
        def ready(j):
            if j["state"] in ("queued", "waiting"): return True
            ts = j.get("next_retry_ts")
            return j["state"] == "retrying" and type(ts) in (int, float) and ts <= now_ts
        candidates = [j for j in jobs if ready(j)]
        candidates.sort(key=lambda x: (0 if x.get("when") == "now" else 1, x.get("created_ts") or 0, x.get("created") or ""))
        for j in candidates:
            pool = pool_of(j)
            if running[pool] >= pool_cap(pool): continue
            if j["when"] == "night":
                if night is None: night = night_ok()
                if not night:
                    if j["state"] == "queued": j["state"] = "waiting"; save(j)
                    continue
            j["next_retry_ts"] = j["next_retry_at"] = None
            start(j)
            running[pool] += 1

def format_job_line(v, hints=False):
    if v.get("percent") is not None:
        if v.get("done") is not None:
            pr = f"{v['percent']}% {v['done']}/{v.get('total','?')} {v.get('speed','')}"
        else:
            pr = f"{v['percent']}% {v.get('total','?')} {v.get('speed','')}"
        if v.get("connections") is not None:
            pr += f" peers:{v['connections']}"
    else:
        pr = ""
    label = retry_label(v)
    extra = f" {label}" if label else ""
    hint = ""
    if hints and v.get("last_error") == "youtube_bot_check":
        hint = "  hint: set --cookies-from-browser chrome"
        if not v.get("proxy_configured"):
            hint += "; or a local proxy: aria-dl config set youtube_proxy http://127.0.0.1:2081"
    shown = (" proxy:" + v["proxy"]) if v.get("proxy") else ""
    return f"{v['id']}  {v['state']:<8} {v['when']:<5} {pr}{extra}{shown}  {v['name']}{hint}"

def out(obj, as_json, hints=False):
    if as_json:
        emit(obj); return
    rows = obj if isinstance(obj, list) else [obj]
    for v in rows:
        print(format_job_line(v, hints=hints))

def exit_for_job(v):
    if v.get("timed_out"): return EXIT_TIMEOUT
    if v.get("state") == "complete": return EXIT_OK
    err = v.get("last_error")
    if err in ("youtube_bot_check", "network"): return EXIT_NETWORK
    if err == "dependency_missing": return EXIT_DEPENDENCY
    if v.get("state") == "failed": return EXIT_FAIL
    return EXIT_OK

def wait_for(job_id, timeout):
    """Block until complete, failed, or removed. Progress lines go to stderr."""
    deadline = None if timeout is None else time.monotonic() + float(timeout)
    last = None
    while True:
        tick()
        try:
            j = refresh(load(job_id))
        except (OSError, ValueError):
            fail(EXIT_NOT_FOUND, "not_found", "job %s disappeared while waiting" % job_id, "It may have been removed.")
        v = view(j)
        v["timed_out"] = False
        if v.get("state") in TERMINAL_STATES:
            return v
        if deadline is not None and time.monotonic() >= deadline:
            shown = int(timeout) if float(timeout) == int(float(timeout)) else timeout
            v["timed_out"] = True
            v["hint"] = "Timed out after %ss; job is still %s. Resume polling: aria-dl status %s --wait" % (shown, v.get("state"), job_id)
            return v
        sig = (v.get("state"), v.get("percent"), v.get("retry_count"), v.get("last_error"))
        if sig != last:
            print(format_job_line(v, hints=False), file=sys.stderr, flush=True)
            last = sig
        time.sleep(0.4)

def collect_sources(o):
    raw = list(o.sources or [])
    from_batch = bool(o.file) or len(raw) > 1
    if o.file:
        f = sys.stdin if o.file == "-" else open(os.path.expanduser(o.file))
        with f:
            raw.extend(f.read().splitlines())
    elif not raw and not sys.stdin.isatty():
        from_batch = True
        raw.extend(sys.stdin.read().splitlines())
    seen, sources = set(), []
    for line in raw:
        s = line.strip()
        if not s or s.startswith("#"): continue
        if s not in seen:
            seen.add(s); sources.append(s)
    if not sources:
        fail(EXIT_USAGE, "usage", "no sources provided (pass URLs/files, --file FILE, or pipe via stdin)",
             "Example: aria-dl add https://example.com/file.zip --json")
    return sources, from_batch

def add_one(raw_src, o, label=None):
    """Return (id, action). action is created, requeued, or exists. The id is sha1(source)[:8]."""
    k = kind_of(raw_src, o.media)
    src = os.path.abspath(os.path.expanduser(raw_src)) if k == "torrent" else raw_src
    i = hashlib.sha1(src.encode()).hexdigest()[:8]
    if os.path.exists(os.path.join(jdir(i), "job.json")):
        j = refresh(load(i))
        if j["state"] in ("complete", "running"):
            return j["id"], "exists"
        if j["state"] in ("failed", "retrying"):
            j["retry_count"] = 0
            j["next_retry_ts"] = j["next_retry_at"] = None
        if o.cookies_from_browser and o.cookies_from_browser.strip():
            j["cookies_from_browser"] = o.cookies_from_browser.strip()
        if o.no_proxy: j["proxy"] = "none"
        elif o.proxy is not None: j["proxy"] = o.proxy.strip()
        j.update(when=o.when, dir=o.dir, limit=o.limit or j.get("limit"),
                 audio=o.audio or j.get("audio"), max_height=o.max_height or j.get("max_height"),
                 max_retries=o.retries, state="queued")
        save(j)
        return j["id"], "requeued"
    os.makedirs(jdir(i), exist_ok=True)
    default_name = (re.search(r"dn=([^&]+)", src) or [None, src[:60]])[1] if k == "magnet" else (os.path.basename(src)[:80] or src[:80])
    browser = o.cookies_from_browser.strip() if o.cookies_from_browser and o.cookies_from_browser.strip() else None
    if o.no_proxy: proxy_val = "none"
    elif o.proxy is not None: proxy_val = o.proxy.strip()
    else: proxy_val = None
    j = {"id": i, "kind": k, "source": src, "dir": o.dir, "when": o.when, "limit": o.limit,
         "audio": o.audio, "max_height": o.max_height,
         "name": label or default_name, "retry_count": 0, "max_retries": o.retries,
         "next_retry_ts": None, "next_retry_at": None, "cookies_from_browser": browser,
         "proxy": proxy_val,
         "state": "queued", "created": now(), "created_ts": time.time(), "pid": None}
    if k == "torrent":
        lt = os.path.join(jdir(i), "source.torrent"); shutil.copy(src, lt); j["local_torrent"] = lt
    save(j)
    return j["id"], "created"

class Parser(argparse.ArgumentParser):
    def error(self, message):
        if GLOBAL_JSON or env_on("ARIA_DL_JSON"):
            emit({"ok": False, "error": "usage", "message": message, "hint": "Run aria-dl --help"})
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, "aria-dl: %s\n" % message)

def common_parser():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--json", action="store_true", help="one JSON value on stdout; logs on stderr (or ARIA_DL_JSON=1)")
    p.add_argument("-y", "--yes", "--non-interactive", action="store_true", dest="yes",
                   help="never prompt (this is already the case when stdin is not a TTY)")
    return p

def build_parser():
    common = common_parser()
    ap = Parser(prog="aria-dl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version="aria-dl %s" % VERSION)
    sp = ap.add_subparsers(dest="cmd", required=True, parser_class=Parser)
    a = sp.add_parser("add", parents=[common], help="queue downloads; the same URL returns the existing job id")
    a.add_argument("sources", nargs="*", help="one or more .torrent paths, magnet links, or URLs")
    a.add_argument("-f", "--file", help="read sources from file (one per line, - for stdin)")
    a.add_argument("--dir", default="~/Downloads")
    a.add_argument("--when", choices=["now", "night"], default="now"); a.add_argument("--name"); a.add_argument("--limit")
    a.add_argument("--media", action="store_true", help="force yt-dlp for any video site URL")
    a.add_argument("--audio", action="store_true", help="media: audio only (m4a)")
    a.add_argument("--max-height", type=int, help="media: max video height, default 1080")
    a.add_argument("--retries", type=int, default=DEFAULT_RETRIES,
                   help="cross-process retries after a failed attempt (default %(default)s, env ARIA_DL_MAX_RETRIES; 0 disables)")
    a.add_argument("--cookies-from-browser", metavar="BROWSER[:PROFILE]",
                   help="yt-dlp browser name, e.g. chrome or 'chrome:Profile 1' (never cookie values)")
