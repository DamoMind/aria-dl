def env_on(name):
    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")

def data_home():
    override = os.environ.get("ARIA_DL_HOME")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return os.path.join(os.path.expanduser("~"), ".local/share/aria-dl")

