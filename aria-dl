def preprocess(argv):
    """Accept --json / --yes before the subcommand or anywhere they are flags."""
    global GLOBAL_JSON, GLOBAL_YES
    GLOBAL_JSON = False
    GLOBAL_YES = False
    out = [argv[0]]
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--":
            out.extend(argv[i:]); break
        if out[-1] in TAKES_VALUE:
            out.append(a); i += 1; continue
        if a == "--json":
            GLOBAL_JSON = True; i += 1; continue
        if a in ("-y", "--yes", "--non-interactive"):
            GLOBAL_YES = True; i += 1; continue
        out.append(a); i += 1
    return out

def _obj_schema(properties, required):
    return {"type": "object", "additionalProperties": False, "properties": properties, "required": required}

def _str(desc): return {"type": "string", "description": desc}
def _int(desc): return {"type": "integer", "description": desc}
def _bool(desc): return {"type": "boolean", "description": desc}
def _strs(desc): return {"type": "array", "items": {"type": "string"}, "description": desc}

def _tool(name, description, properties, required, argv, positionals=None, flags=None):
    schema = _obj_schema(properties, required)
    return {
        "name": name,
        "description": description,
        "parameters": schema,
        "input_schema": schema,
        "aria_dl": {"argv": argv, "positionals": positionals or [], "flags": flags or {}},
    }

