def queue_resume(j):
    if j["state"] in ("failed", "retrying"): j["retry_count"] = 0
    j["next_retry_ts"] = j["next_retry_at"] = None
    j["state"] = "queued"
    save(j)
def config_show(key, value):
    if key in ("youtube_proxy", "proxy"):
        if value is None or proxy_disabled(value): return ""
        return proxy_hostport(value) or ""
    return "" if value is None else str(value)
def config_public(key, value):
    if key in ("youtube_proxy", "proxy"):
        if value is None or proxy_disabled(value): return None
        return proxy_hostport(str(value))
    if value is None: return None
    return str(value)
def config_cli(o):
    key = getattr(o, "key", None)
    if key and key not in CONFIG_KEYS:
        fail(EXIT_USAGE, "usage", "unknown config key %s" % key, "Keys: %s." % ", ".join(CONFIG_KEYS))
    data = load_config()
    if o.config_cmd == "set":
        data[o.key] = o.value
        save_config(data)
        shown = config_public(o.key, o.value)
        if OUT_JSON: emit({"key": o.key, "value": shown})
        else: print("%s=%s" % (o.key, "" if shown is None else shown))
    elif o.config_cmd == "unset":
        data.pop(o.key, None)
        save_config(data)
        if OUT_JSON: emit({"key": o.key, "value": None, "unset": True})
        else: print("unset %s" % o.key)
    elif o.key:
        shown = config_public(o.key, data.get(o.key)) if o.key in data else None
        if OUT_JSON: emit({"key": o.key, "value": shown})
        else: print(config_show(o.key, data.get(o.key)))
    elif OUT_JSON:
        emit({name: (config_public(name, data.get(name)) if name in data else None) for name in CONFIG_KEYS})
    else:
        for name in CONFIG_KEYS:
            if name in data: print("%s=%s" % (name, config_show(name, data.get(name))))
def present_add(views, errors, from_batch):
    if OUT_JSON:
        if not from_batch and len(views) == 1 and not errors: out(views[0], True)
        elif not from_batch and not views and len(errors) == 1: out(errors[0], True)
        else: out(list(views) + list(errors), True)
    elif views:
        out(views, False)
    if not OUT_JSON:
        for v in views:
            if v.get("last_error") == "dependency_missing" and v.get("hint"):
                print(v["hint"], file=sys.stderr)
    if errors: sys.exit(EXIT_FAIL)
    if any(v.get("last_error") == "dependency_missing" for v in views): sys.exit(EXIT_DEPENDENCY)
def dispatch(o):
    if o.cmd == "add":
        sources, from_batch = collect_sources(o)
        made, errors = [], []
        for idx, s in enumerate(sources, 1):
            label = f"{o.name} #{idx}" if (o.name and len(sources) > 1) else o.name
            try:
                made.append(add_one(s, o, label=label))
            except ValueError as e:
                msg = redact(str(e))
                errors.append({"ok": False, "source": redact(s), "error": msg,
                               "hint": "Pass a magnet link, an http(s) URL, an existing .torrent path, or --media for a video page."})
                print("aria-dl: error adding %s: %s" % (redact(s), msg), file=sys.stderr)
            except Exception as e:
                msg = redact(str(e))
                errors.append({"ok": False, "source": redact(s), "error": msg})
                print("aria-dl: error adding %s: %s" % (redact(s), msg), file=sys.stderr)
        if made: tick()
        views = []
        for i, action in made:
            v = view(refresh(load(i)))
            v["existed"] = action != "created"
            v["action"] = action
            v["ok"] = v.get("last_error") != "dependency_missing"
            views.append(v)
        present_add(views, errors, from_batch)
    elif o.cmd == "list": out([view(j) for j in all_jobs()], OUT_JSON)
    elif o.cmd == "status":
        if (o.wait or o.timeout is not None) and len(o.ids) != 1:
            fail(EXIT_USAGE, "usage", "--wait takes exactly one job id")
        if o.timeout is not None and o.timeout < 0:
            fail(EXIT_USAGE, "usage", "--timeout must be >= 0")
        if o.wait or o.timeout is not None:
            j = find(o.ids[0])
            v = wait_for(j["id"], o.timeout)
            out(v, OUT_JSON, hints=True)
            sys.exit(exit_for_job(v))
        views = [view(find(i)) for i in o.ids]
        out(views if len(views) > 1 else views[0], OUT_JSON, hints=True)
    elif o.cmd == "pause":
        targets = [j for j in all_jobs() if j["state"] in ("running", "queued", "waiting", "retrying")] if o.ids == ["all"] else [find(i) for i in o.ids]
        for j in targets:
            stop(j, "paused")
            j["next_retry_ts"] = j["next_retry_at"] = None
            save(j)
        views = [view(j) for j in targets]
        out(views if (len(o.ids) > 1 or o.ids == ["all"]) else (views[0] if views else []), OUT_JSON)
    elif o.cmd == "resume":
        pure_all = o.ids == ["all"]
        targets, labels, named = pick_targets(o.ids, RESUME_SELECTORS)
        if not targets:
            if named or pure_all: no_match(OUT_JSON)
        else:
            for j in targets: queue_resume(j)
            tick()
            views = [view(refresh(load(j["id"]))) for j in targets]
            if named and not pure_all:
                if OUT_JSON: out(views, True)
                else: print(bulk_line("resumed", len(views), labels))
            else:
                out(views if (len(o.ids) > 1 or pure_all) else views[0], OUT_JSON)
    elif o.cmd == "remove":
        targets, labels, named = pick_targets(o.ids, REMOVE_SELECTORS)
        if named and not targets:
            no_match(OUT_JSON)
        else:
            views = []
            for j in targets:
                stop(j, "removed"); views.append(view(j)); shutil.rmtree(jdir(j["id"]))
                if not named and not OUT_JSON:
                    print("removed job %s (files kept in %s)" % (j["id"], j["dir"]))
            if targets: tick()
            if named:
                if OUT_JSON: out(views, True)
                else: print(bulk_line("removed", len(views), labels))
            elif OUT_JSON:
                out(views if len(views) > 1 else views[0], True)
    elif o.cmd == "log":
        j = find(o.id)
        path = os.path.join(jdir(j["id"]), "aria2.log")
        try:
            with open(path, encoding="utf-8", errors="replace") as f: lines = f.read().splitlines()
        except OSError:
            lines = []
        lines = [redact(x) for x in lines[-max(0, o.n):]]
        if OUT_JSON: emit({"id": j["id"], "lines": lines})
        else:
            for line in lines: print(line)
    elif o.cmd == "cookies":
        if o.cookies_cmd == "status":
            info = cookies_status()
            if OUT_JSON: emit(info)
            else: print_cookies_status(info)
        else:
            emit_refresh(perform_refresh(o.browser or default_cookie_browser()), OUT_JSON)
    elif o.cmd == "config":
        config_cli(o)
    elif o.cmd == "version":
        info = version_info()
        if OUT_JSON: emit(info)
        else:
            print("aria-dl %s" % info["version"])
            for name, ok in info["dependencies"].items():
                print("%s: %s" % (name, "yes" if ok else "no"))
    elif o.cmd == "schema":
        emit(schema_document())
    elif o.cmd == "tools":
        emit(tools_document())
    elif o.cmd == "tick": tick()

if __name__ == "__main__": main()
